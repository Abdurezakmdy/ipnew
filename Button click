<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My GitHub Page</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Changed to an ID so JavaScript can target it -->
    <h1 id="greeting-title">Hello, GitHub!</h1>
    <p>This is my website template hosted directly on GitHub.</p>

    <!-- --- ADDED: Name Input Field --- -->
    <div class="section">
        <input type="text" id="name-input" placeholder="Type your name here..." oninput="updateGreeting()">
    </div>

    <!-- Interactive Counter Section -->
    <div class="section">
        <button class="interactive-btn" onclick="incrementClick()">Click Me!</button>
        <!-- --- ADDED: Reset Button --- -->
        <button class="reset-btn" onclick="resetClick()">Reset</button>
        <p id="counter-display">Button clicked: 0 times</p>
    </div>

    <script src="script.js"></script>
</body>
</html>
